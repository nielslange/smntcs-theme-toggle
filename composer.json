{
	"name": "nielslange/smntcs-theme-toggle",
	"description": "Toggle between the default WordPress theme and a custom theme.",
	"homepage": "https://github.com/nielslange/smntcs-theme-toggle",
	"type": "wordpress-plugin",
	"keywords": [
		"WordPress",
		"Plugin",
		"SMNTCS Theme Toggle"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Niels Lange",
			"email": "info@nielslange.de"
		}
	],
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
		"humanmade/psalm-plugin-wordpress": "^3.1.2",
		"overtrue/phplint": "^9.7",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"squizlabs/php_codesniffer": "^3.13.5",
		"vimeo/psalm": "^6.18",
		"wp-coding-standards/wpcs": "^3.4.1"
	},
	"scripts": {
		"phpcbf": "phpcbf --standard=phpcs.xml .",
		"phpcs": "phpcs --standard=phpcs.xml .",
		"phplint": "phplint",
		"psalm": "psalm --no-cache"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
